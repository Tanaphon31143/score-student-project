# ===== TiDB Cloud (MySQL-compatible) =====
# ดูค่าได้ที่ TiDB Cloud Console > Cluster > Connect
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=
TIDB_DATABASE=test
# TiDB Serverless บังคับใช้ SSL
TIDB_ENABLE_SSL=true

# Connection string (สำหรับ Prisma / Drizzle / ORM อื่น ๆ)
DATABASE_URL=mysql://xxxxxxxx.root:<PASSWORD>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?sslaccept=strict

# ===== Cloudinary =====
# ดูค่าได้ที่ Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ใช้ฝั่ง client (เช่น next-cloudinary / upload widget) — ห้ามใส่ secret ในตัวแปร NEXT_PUBLIC_
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ===== Better Auth =====
# สร้างค่าสุ่ม: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Production ให้ใส่โดเมนจริง, Preview ปล่อยว่างได้
BETTER_AUTH_URL=http://localhost:3000

# ===== Google OAuth =====
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
